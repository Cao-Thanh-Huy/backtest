# PostgreSQL
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant_secret_2024
POSTGRES_DB=quantdb

# MinIO (S3 compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret_2024
MINIO_BUCKET_RAW=raw-data
MINIO_BUCKET_PROCESSED=processed-data
MINIO_BUCKET_MODELS=ml-models

# AWS / MinIO Access Keys
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_secret_2024

# MLflow
MLFLOW_BACKEND_STORE_URI=postgresql://quant:quant_secret_2024@postgres:5432/quantdb?search_path=mlflow
MLFLOW_ARTIFACT_ROOT=s3://ml-models/
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# Celery Worker Features (Memory limits and concurrency)
CELERY_FEATURES_MEM_LIMIT=8g
CELERY_FEATURES_MEM_RESERVATION=4g
CELERY_FEATURES_CONCURRENCY=3
CELERY_FEATURES_MAX_TASKS_PER_CHILD=10

# Celery Worker Aux (Concurrency and tasks limit)
CELERY_AUX_CONCURRENCY=2
CELERY_AUX_MAX_TASKS_PER_CHILD=50
CELERY_BROKER_URL=redis://valkey:6379/0

# Frontend Next.js Public URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MLFLOW_URL=http://localhost:5000
